# Konfigurasi Apache untuk hosting cPanel.
# File ini otomatis tersalin ke folder dist/ saat `npm run build`.

DirectoryIndex index.html

<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Teruskan header Authorization ke PHP. Tanpa ini, login Bearer gagal di
  # hosting yang menjalankan PHP sebagai CGI/FastCGI.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Jangan pernah melayani isi folder .git lewat web.
  RewriteRule (^|/)\.git - [F,L]

  # Blokir berkas yang tidak untuk diakses publik.
  RewriteRule \.(sql|md|log|ini|sample\.php)$ - [F,L]

  # Cegah eksekusi PHP dari folder upload gambar.
  RewriteRule ^uploads/.*\.(php|phtml|phar)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  # Aset hasil build berganti nama setiap berubah, aman di-cache lama.
  <FilesMatch "\.(js|css|woff2?|webp|jpe?g|png|svg|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html harus selalu diambil ulang supaya update langsung terlihat.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
